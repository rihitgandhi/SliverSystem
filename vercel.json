{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/install_vercel_browser.py",
  "fluid": true,
  "functions": {
    "app.py": {
      "includeFiles": ".playwright/**",
      "excludeFiles": "{sources/**,docs/**,Wind power/**,**/test_*.py,**/*-proof.png,**/*.backup,**/*.bak}",
      "maxDuration": 300
    }
  }
}
